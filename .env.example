# Public browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "staging" shows the test banner and noindex headers; other values hide it.
NEXT_PUBLIC_APP_ENV=

# Server-only. Never prefix with NEXT_PUBLIC_ and never import into client code.
SUPABASE_SERVICE_ROLE_KEY=
# First-admin bootstrap code (min 8 chars, server-only). Set it before using /admin/bootstrap.
BOOTSTRAP_ADMIN_SECRET=
# Cron secret (min 16 chars, server-only). Set it before using /api/cron/expire-payments.
CRON_SECRET=
